#!/usr/bin/env bash

set -euo pipefail

readonly GREEN='\033[1;32m'
readonly RED='\033[1;31m'
readonly RESET='\033[0m'

stage="initialization"

trap 'rc=$?; printf "${RED}✗ Failed: %s (exit code: %d)${RESET}\n" "$stage" "$rc"' ERR

run() {
    stage="$1"
    shift

    "$@"

    printf "${GREEN}✓ %s${RESET}\n" "$stage"
}

run "fmt" cargo fmt --all -- --check
run "lint" cargo clippy --all-targets --all-features --quiet -- -D warnings
run "test" cargo test --all-targets --quiet
run "build" cargo build -q --all-targets

trap - ERR

echo -e "${GREEN}✔ Done!${RESET}"
